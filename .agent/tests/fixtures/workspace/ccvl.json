{
  "format": "ccvl-workspace",
  "schema_version": 9,
  "workspace_groups": {
    "inputs": {
      "root": "inputs",
      "profile": "inputs/profile.toml",
      "interviews": "inputs/interviews",
      "stations": "inputs/interviews/stations.toml",
      "assets": "inputs/assets",
      "signature": "inputs/assets/images/signatures/signature.png",
      "library": "inputs/library"
    },
    "outputs": {
      "root": "outputs",
      "cvl": "outputs/cvl",
      "cv": "outputs/cvl/cv",
      "cl": "outputs/cvl/cl",
      "shared": "outputs/cvl/shared"
    },
    "opportunities": {
      "root": "opportunities",
      "path": "opportunities/<organisation-key>/<position-key>",
      "record": "application.toml",
      "pdfs": "pdfs",
      "typst": "typst"
    }
  },
  "documents": {
    "cv": {
      "root": "outputs/cvl/cv",
      "default_style": "ledger",
      "slots": {
        "styles": 3,
        "substyles": 3
      }
    },
    "cover_letter": {
      "root": "outputs/cvl/cl",
      "default_style": "ledger",
      "slots": {
        "styles": 3,
        "substyles": 3
      }
    }
  }
}
