{
  "format": "ccvl-workspace",
  "schema_version": 9,
  "workspace_groups": {
    "inputs": {
      "root": "inputs",
      "profile": "inputs/profile.toml",
      "interviews": "inputs/interviews",
      "stations": "inputs/interviews/stations.toml",
      "assets": "inputs/assets",
      "signature": "inputs/assets/images/signatures/signature.png",
      "library": "inputs/library"
    },
    "outputs": {
      "root": "outputs",
      "cvl": "outputs/cvl",
      "cv": "outputs/cvl/cv",
      "cl": "outputs/cvl/cl",
      "shared": "outputs/cvl/shared",
      "flyers": "outputs/flyers",
      "web": "outputs/web",
      "videos": "outputs/videos",
      "presentations": "outputs/presentations",
      "portfolios": "outputs/portfolios"
    },
    "opportunities": {
      "root": "opportunities",
      "path": "opportunities/<organisation-key>/<position-key>",
      "record": "application.toml",
      "pdfs": "pdfs",
      "typst": "typst",
      "kanban": "opportunities/kanban.toml"
    }
  },
  "skills": [
    "ccvl-install",
    "ccvl-profile",
    "ccvl-cv",
    "ccvl-apply",
    "ccvl-interview",
    "ccvl-upskill",
    "ccvl-outcome",
    "ccvl-style",
    "ccvl-review"
  ],
  "documents": {
    "cv": {
      "root": "outputs/cvl/cv",
      "default_style": "harvard",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    },
    "cl": {
      "root": "outputs/cvl/cl",
      "default_style": "harvard",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    },
    "flyers": {
      "root": "outputs/flyers",
      "default_style": "scaffold",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    },
    "web": {
      "root": "outputs/web",
      "default_style": "scaffold",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    },
    "videos": {
      "root": "outputs/videos",
      "default_style": "scaffold",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    },
    "presentations": {
      "root": "outputs/presentations",
      "default_style": "scaffold",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    },
    "portfolios": {
      "root": "outputs/portfolios",
      "default_style": "scaffold",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    }
  }
}
