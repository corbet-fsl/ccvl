{
  "format": "ccvl-workspace",
  "schema_version": 9,
  "workspace_groups": {
    "inputs": {
      "profile": "cvl/profile.toml",
      "interviews": "interview",
      "stations": "interview/stations.toml",
      "assets": "cvl/assets",
      "signature": "cvl/assets/signature.png"
    },
    "outputs": {
      "cvl": "cvl",
      "cv": "cvl/cv",
      "cl": "cvl/cl",
      "shared": "cvl/shared"
    },
    "opportunities": {
      "root": "opportunities",
      "path": "opportunities/<organisation-key>/<position-key>",
      "record": "application.toml",
      "pdfs": "pdfs",
      "typst": "typst"
    }
  },
  "skills": [
    "ccvl-install",
    "ccvl-profile",
    "ccvl-cv",
    "ccvl-apply",
    "ccvl-interview",
    "ccvl-upskill",
    "ccvl-outcome",
    "ccvl-style",
    "ccvl-review"
  ],
  "documents": {
    "cv": {
      "root": "cvl/cv",
      "default_style": "harvard",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    },
    "cover_letter": {
      "root": "cvl/cl",
      "default_style": "harvard",
      "slots": {
        "styles": 4,
        "substyles": 5
      }
    }
  }
}
