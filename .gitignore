# Opportunity outputs (pdfs/ + typst/) are committed (PDFs via LFS).

# Private user knowledge; only the public scaffold and station example ship.
/inputs/interviews/*
!/inputs/interviews/README.md
!/inputs/interviews/imports/
/inputs/interviews/imports/*
!/inputs/interviews/imports/README.md
!/inputs/interviews/stations.toml

# Local build state
/.agent/cache/
/target/

# Secrets
.env
.env.*
!.env.example

# CI runtime state (moon/ccid per-run caches and generated configs): tool
# outputs, never reviewed source. REUSE lint skips gitignored paths while
# still reviewing all tracked source; the documents publication scan is
# unaffected (it keys on symlinks, not ignore status).
/.moon/
/.ccid/
/moon.yml

# Editor and office temporary files
.DS_Store
Thumbs.db
.nfs*
.~lock.*#
~$*.doc*
~$*.xls*
*.bak
*.log
*.tmp
